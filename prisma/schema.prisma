generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id
  name                  String
  email                 String
  emailVerified         Boolean                @default(false)
  image                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  sessions              Session[]
  accounts              Account[]
  restaurantMemberships RestaurantMembership[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum RestaurantRole {
  ADMIN
  STAFF
}

model Restaurant {
  id                String                 @id @default(cuid())
  name              String
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  memberships       RestaurantMembership[]
  tables            RestaurantTable[]
  catalogCategories CatalogCategory[]

  @@map("restaurant")
}

model RestaurantMembership {
  id           String         @id @default(cuid())
  restaurantId String
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         RestaurantRole
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([restaurantId, userId])
  @@index([userId])
  @@map("restaurant_membership")
}

model CatalogCategory {
  id           String        @id @default(cuid())
  restaurantId String
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  key          String
  name         String
  sortOrder    Int
  items        CatalogItem[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([restaurantId, key])
  @@unique([id, restaurantId])
  @@index([restaurantId, sortOrder])
  @@map("catalog_category")
}

model CatalogItem {
  id             String          @id @default(cuid())
  restaurantId   String
  categoryId     String
  category       CatalogCategory @relation(fields: [categoryId, restaurantId], references: [id, restaurantId], onDelete: Cascade)
  key            String
  name           String
  unitPriceMinor Int
  isActive       Boolean         @default(true)
  sortOrder      Int
  billItems      BillItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([restaurantId, key])
  @@index([categoryId, sortOrder])
  @@index([restaurantId, isActive])
  @@map("catalog_item")
}

model RestaurantTable {
  id            String         @id @default(cuid())
  publicId      String         @unique @default(cuid())
  name          String
  isActive      Boolean        @default(true)
  restaurantId  String
  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableSessions TableSession[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([restaurantId, name])
  @@index([restaurantId, isActive])
  @@map("restaurant_table")
}

model TableSession {
  id                String          @id @default(cuid())
  restaurantTableId String
  restaurantTable   RestaurantTable @relation(fields: [restaurantTableId], references: [id], onDelete: Cascade)
  joinCodeDigest    String
  joinCodeExpiresAt DateTime
  closedAt          DateTime?
  billItems         BillItem[]
  guestSessions     GuestSession[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([restaurantTableId, createdAt])
  @@map("table_session")
}

model BillItem {
  id             String               @id @default(cuid())
  tableSessionId String
  tableSession   TableSession         @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  catalogItemId  String?
  catalogItem    CatalogItem?         @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  name           String
  quantity       Int
  unitPriceMinor Int
  allocations    BillItemAllocation[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([id, tableSessionId])
  @@index([tableSessionId])
  @@index([catalogItemId])
  @@map("bill_item")
}

model BillItemAllocation {
  id             String       @id @default(cuid())
  tableSessionId String
  billItemId     String
  billItem       BillItem     @relation(fields: [billItemId, tableSessionId], references: [id, tableSessionId], onDelete: Restrict)
  guestSessionId String
  guestSession   GuestSession @relation(fields: [guestSessionId, tableSessionId], references: [id, tableSessionId], onDelete: Restrict)
  quantity       Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([guestSessionId, billItemId])
  @@index([billItemId])
  @@index([tableSessionId])
  @@map("bill_item_allocation")
}

model GuestSession {
  id             String               @id @default(cuid())
  tableSessionId String
  tableSession   TableSession         @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  tokenHash      String               @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  allocations    BillItemAllocation[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([id, tableSessionId])
  @@index([tableSessionId])
  @@map("guest_session")
}
